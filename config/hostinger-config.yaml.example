---
name: Example
rules:
  - action: accept
    protocol: SSH
    port: "22"
    source: any
    source_detail: any
  - action: accept
    protocol: HTTP
    port: "80"
    source: any
    source_detail: any
  - action: accept
    protocol: HTTPS
    port: "443"
    source: any
    source_detail: any
  - action: accept
    protocol: UDP
    port: "443"
    source: any
    source_detail: any
  - action: accept
    protocol: HTTPS
    port: "443"
    source: custom
    source_detail: "{{ dns_record }}"
  # Optional: Restrict a port (e.g. Zabbix 10051) to a specific domain or CNAME record
  # using "{{ dns_record:sub.example.com }}" (or by adding cname: "sub.example.com"):
  # - action: accept
  #   protocol: TCP
  #   port: "10051"
  #   source: custom
  #   source_detail: "{{ dns_record:zabbix.example.com }}"
