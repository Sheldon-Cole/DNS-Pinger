# ==============================================================================
# General & DNS Settings
# ==============================================================================

# Comma-separated list of domains whose DNS records should be mapped to rules
DOMAINS=example.com,sub.example.com

# DNS record types to resolve, comma-separated (default: A, supports A,AAAA)
RECORD_TYPES=A

# Interval between DNS & policy/firewall checks in seconds (default: 300)
INTERVAL=300

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Set to true to print detailed JSON responses from APIs at DEBUG level (default: false)
PRETTY_JSON=false

# ==============================================================================
# Hostinger VPS Firewall Settings (Optional if only using Pangolin)
# ==============================================================================

# Hostinger API Access Token (VPS API permission required; APIKEY is also supported)
HOSTINGER_API_KEY=your_hostinger_api_token_here

# Name of the firewall group in Hostinger VPS panel (optional, if omitted uses first available)
FIREWALL_NAME=MyFirewallGroup

# Path to Hostinger firewall rules configuration YAML file (default: ./config/hostinger-config.yaml)
HOSTINGER_CONFIG_PATH=./config/hostinger-config.yaml

# ==============================================================================
# Pangolin Shared Policy Settings (Optional if only using Hostinger)
# ==============================================================================

# Base URL for your Pangolin Integration API (e.g. https://api.example.com)
PANGOLIN_URL=https://api.example.com

# Pangolin Integration API Key (requires Get Resource Policy & Set Resource Policy Rules permissions)
PANGOLIN_API_KEY=your_pangolin_api_token_here

# Numeric ID of the Pangolin Shared Policy to manage (recommended)
PANGOLIN_POLICY_ID=1

# Or look up the policy by Organization ID and Policy Name / niceId (requires List Resource Policies permission)
# PANGOLIN_ORG_ID=my-org
# PANGOLIN_POLICY_NAME=My Shared Policy

# Path to Pangolin policy rules configuration YAML file (default: ./config/pangolin-config.yaml)
PANGOLIN_CONFIG_PATH=./config/pangolin-config.yaml
