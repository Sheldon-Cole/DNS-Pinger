# Hostinger API Access Token (VPS API permission required)
APIKEY=your_hostinger_api_token_here

# Comma-separated list of domains whose DNS records should be mapped to the firewall
DOMAINS=example.com,sub.example.com

# DNS record types to resolve, comma-separated (default: A, supports A,AAAA)
RECORD_TYPES=A

# Name of the firewall group in Hostinger VPS panel (optional, if omitted uses first available)
FIREWALL_NAME=MyFirewallGroup

# Interval between DNS & firewall checks in seconds (default: 300)
INTERVAL=300

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Set to true to print detailed JSON responses from Hostinger API at DEBUG level (default: false)
PRETTY_JSON=false

# Path to firewall rules configuration YAML file (default: ./config/firewall-config.yaml)
CONFIG_PATH=./config/firewall-config.yaml
